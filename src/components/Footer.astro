---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const tarifsHref = home ? "#tarifs" : "/#tarifs";
---

<footer class="site-footer">
  <div class="footer-bg" aria-hidden="true"></div>
  <div class="container footer-inner">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <div class="col-label">Olivier Gaillard</div>
        <p>Entraîneur d'athlétisme à Lyon. Coaching à distance tous niveaux, et fondateur du groupe AP au sein de l'ACL.</p>
      </div>
      <div class="footer-col">
        <div class="col-label">Navigation</div>
        <ul>
          <li><a href="/">Accueil</a></li>
          <li><a href="/coach">Le Coach</a></li>
          <li><a href="/coaching-a-distance">Coaching à distance</a></li>
          <li><a href={tarifsHref}>Les formules</a></li>
          <li><a href="/athlete-project">Athlete Project</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <div class="col-label">Me suivre</div>
        <ul>
          <li>
            <a href="https://www.instagram.com/olivier_gllrd" target="_blank" rel="noopener">
              <svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.8" cy="6.2" r="1.1" fill="currentColor" stroke="none"/></svg>
              Instagram<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
          <li>
            <a href="https://www.nolio.io/marketplace/coach/olivier.gaillard/" target="_blank" rel="noopener">
              <img src="/assets/nolio-logo.webp" width="15" height="15" alt="" aria-hidden="true" loading="lazy" decoding="async" />
              Nolio<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
          <li>
            <a href="https://www.strava.com/athletes/6312500" target="_blank" rel="noopener">
              <img src="/assets/strava-logo.webp" width="11" height="15" alt="" aria-hidden="true" loading="lazy" decoding="async" />
              Strava<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Olivier Gaillard. Tous droits réservés</span>
      <span><a href="/mentions-legales">Mentions légales</a>, Lyon, France, olivier-gaillard.fr</span>
    </div>
  </div>
</footer>
