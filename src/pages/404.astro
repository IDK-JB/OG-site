---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Page introuvable, Olivier Gaillard"
  description="La page demandée n'existe pas ou a été déplacée."
  active="legal"
  noindex
>

  <section class="page-hero">
    <div class="container">
      <h1 class="hero-title">
        <span class="line">4<span class="accent">0</span>4<span class="accent">.</span></span>
        <span class="sr-only">Page introuvable</span>
      </h1>
      <p class="lead">
        La page que vous cherchez n'existe plus ou a changé d'adresse. Par
        ici, on retourne sur la piste.
      </p>
      <div class="hero-actions">
        <a href="/" class="btn btn-solid">Retour à l'accueil <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/coaching-a-distance" class="btn btn-ghost">Le coaching à distance</a>
      </div>
    </div>
  </section>

</Base>
