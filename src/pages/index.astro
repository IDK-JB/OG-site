---
import Base from "../layouts/Base.astro";
import Avis from "../components/Avis.astro";
import { AVIS, NOTE_MOYENNE_LD, NOMBRE_AVIS } from "../data/avis";

// Avis de démonstration : remplacer par de vrais avis clients avant l'indexation.
const businessId = new URL("/#coaching", Astro.site ?? "https://oliviergaillard.fr").href;
const avisLd: Record<string, unknown>[] = [
  {
    "@id": businessId,
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: NOTE_MOYENNE_LD,
      bestRating: 5,
      reviewCount: NOMBRE_AVIS,
    },
  },
  ...AVIS.map((a) => ({
    "@type": "Review",
    author: { "@type": "Person", name: a.nom },
    reviewRating: { "@type": "Rating", ratingValue: a.note, bestRating: 5 },
    reviewBody: a.texte,
    inLanguage: "fr-FR",
    itemReviewed: { "@id": businessId },
  })),
];
---

<Base
  title="Coach sportif running à Lyon et à distance · Olivier Gaillard"
  description="Coach running et entraîneur d'athlétisme FFA à Lyon. Plans d'entraînement sur mesure, à Lyon ou à distance : 10 km, semi, marathon, demi-fond. Premier échange gratuit."
  active="home"
  home={true}
  imageAlt="Coureuse à l'entraînement de nuit, coaching running à Lyon"
  jsonLd={avisLd}
  preload={{
    href: "/assets/hero-runner.webp",
    srcset: "/assets/hero-runner-960.webp 960w, /assets/hero-runner.webp 1920w",
    sizes: "100vw",
  }}
>

  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-media">
      <img
        src="/assets/hero-runner.webp"
        srcset="/assets/hero-runner-960.webp 960w, /assets/hero-runner.webp 1920w"
        sizes="100vw"
        width="1920"
        height="1436"
        fetchpriority="high"
        decoding="async"
        alt="Coureuse à l'entraînement de nuit, coaching running à Lyon"
      />
    </div>
    <div class="container hero-content">
      <h1 class="hero-title">
        <span class="line">Olivier</span>
        <span class="line">Gaillard</span>
        <span class="line"><span class="accent">Coach.</span></span>
        <span class="sr-only">Coach running et entraîneur d'athlétisme à Lyon et à distance</span>
      </h1>
      <p class="hero-sub">
        Entraîneur demi-fond et running depuis 2009. Du premier 10 km au
        record personnel : un plan sur mesure, un vrai suivi, et quelqu'un
        qui répond quand vous avez une question. Débutant ou élite, votre
        projet devient le nôtre.
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-solid">Me contacter <span class="arrow" aria-hidden="true">→</span></a>
        <a href="#coaching" class="btn btn-ghost">Le coaching</a>
      </div>
    </div>
  </section>

  <!-- ================= CHIFFRES ================= -->
  <section class="stats-band">
    <div class="container">
      <div class="stats-grid">
        <div class="stat" data-reveal="1">
          <div class="stat-num">30<em>+</em></div>
          <div class="stat-label">Ans de course à pied</div>
        </div>
        <div class="stat" data-reveal="2">
          <div class="stat-num">500<em>+</em></div>
          <div class="stat-label">Coureurs accompagnés depuis 2009</div>
        </div>
        <div class="stat" data-reveal="3">
          <div class="stat-num">5</div>
          <div class="stat-label">Podiums nationaux par des athlètes accompagnés</div>
        </div>
        <div class="stat" data-reveal="4">
          <div class="stat-num">1</div>
          <div class="stat-label">Champion de France entraîné, sélection mondiale 2018</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= QUI JE SUIS ================= -->
  <section class="section" id="apropos">
    <div class="container">
      <div class="split split--apropos">
        <div class="text-block" data-reveal="1">
          <h2 class="section-title" data-reveal>Qui je suis</h2>
          <p class="lead">
            44 ans, entraîneur et formateur diplômé de la Fédération
            Française d'Athlétisme. Licence STAPS et diplôme universitaire
            de préparation physique en poche.
          </p>
          <p class="muted" style="margin-top: 1.4em;">
            Depuis 2009, j'entraîne en club, actuellement à l'Athletic
            Club du Lyonnais, et j'accompagne tous types d'athlètes via
            des suivis personnalisés. En 2024, je crée à Lyon le
            collectif&nbsp;<strong>AP (Athlete Project)</strong> : émulation, cohésion de
            groupe, et les outils pour viser la haute performance.
          </p>
          <a href="/coach" class="more-link">Mon parcours complet <span aria-hidden="true">→</span></a>
        </div>
        <figure class="portrait" data-reveal="2">
          <img
            src="/assets/olivier-qui-suis-je.webp"
            width="1050"
            height="1400"
            loading="lazy"
            decoding="async"
            alt="Olivier Gaillard, coach running et entraîneur FFA à Lyon, au bord de la piste"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ================= COACHING A DISTANCE ================= -->
  <section class="section" id="coaching">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">Le coaching à distance</h2>
      </div>
      <p class="lead" style="margin-bottom: clamp(40px, 6vw, 70px);" data-reveal="1">
        Pas de séance type ni de plan copié-collé. Chaque préparation suit
        le même fil, adapté à votre niveau et à votre objectif.
      </p>
      <div class="steps" data-reveal="2">
        <div class="step">
          <div class="step-num">01</div>
          <h3 class="step-title">Premier échange</h3>
          <p>On se parle. Vos objectifs, votre histoire sportive, vos contraintes du quotidien. Gratuit, sans engagement.</p>
        </div>
        <div class="step">
          <div class="step-num">02</div>
          <h3 class="step-title">Bilan de départ</h3>
          <p>Analyse de votre passé d'entraînement, de vos temps, de vos disponibilités. On fixe un cap réaliste.</p>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <h3 class="step-title">Votre plan sur Nolio</h3>
          <p>Vos séances semaine par semaine, directement sur votre téléphone ou programmées sur votre montre, avec les allures et les consignes.</p>
        </div>
        <div class="step">
          <div class="step-num">04</div>
          <h3 class="step-title">Suivi & ajustements</h3>
          <p>Vos retours après certaines séances, le plan ajusté chaque semaine. La forme monte, le plan suit.</p>
        </div>
      </div>
      <p class="steps-note" data-reveal="3">
        <strong>Tous niveaux</strong> : du premier 10 km au marathon, de la remise en forme à la performance.
      </p>
    </div>
  </section>

  <Avis />

  <!-- ================= TARIFS ================= -->
  <section class="section" id="tarifs">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">Les formules</h2>
      </div>
      <div class="pricing">
        <article class="plan" data-reveal="1">
          <h3 class="plan-name">Suivi performance</h3>
          <div class="plan-price">
            <span class="amount">80 €</span>
            <span class="per">/ mois</span>
          </div>
          <p class="plan-desc">Pour courir avec un plan sérieux, où que vous soyez.</p>
          <ul class="plan-list">
            <li>Plan d'entraînement personnalisé sur Nolio</li>
            <li>Ajustements chaque semaine</li>
            <li>Analyse de vos séances</li>
            <li>Échanges par messages Nolio, réponse sous 24 à 48 h</li>
          </ul>
          <a href="#contact" class="btn btn-ghost">Commencer <span class="arrow" aria-hidden="true">→</span></a>
        </article>
        <article class="plan plan-featured" data-reveal="2">
          <h3 class="plan-name">Suivi premium</h3>
          <div class="plan-price">
            <span class="amount">130 €</span>
            <span class="per">/ mois</span>
          </div>
          <p class="plan-desc">Pour viser un chrono, avec un suivi renforcé sur le plan nutritionnel en partenariat avec Deborah Maurice, diététicienne nutritionniste diplômée.</p>
          <ul class="plan-list">
            <li>Tout le suivi en ligne inclus</li>
            <li>Accompagnement nutritionnel spécialisé pour les sportifs en relation avec les objectifs et le plan d'entraînement</li>
            <li>Disponibilité prioritaire, 7 j/7 par message WhatsApp</li>
          </ul>
          <a href="#contact" class="btn btn-solid">Commencer <span class="arrow" aria-hidden="true">→</span></a>
        </article>
      </div>
      <p class="pricing-note" data-reveal="3">Le premier échange est toujours gratuit : on en parle avant de décider.</p>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-intro" data-reveal="1">
          <h2 class="section-title">Me contacter</h2>
          <p class="lead">
            Un objectif, une question, un doute sur votre plan actuel ?
            Écrivez-moi, je réponds à tout le monde.
          </p>
          <p class="contact-direct">
            <a href="mailto:contact@oliviergaillard.fr">contact@oliviergaillard.fr</a>
          </p>
        </div>

        <form class="contact-form" id="contactForm" novalidate aria-describedby="form-note" data-reveal="2">
          <p class="form-note full" id="form-note">Tous les champs sont obligatoires.</p>
          <div class="field">
            <label for="nom">Nom et prénom</label>
            <input type="text" id="nom" name="nom" autocomplete="name" required aria-required="true" placeholder="Martin Julie" aria-describedby="nom-error" />
            <p class="field-error" id="nom-error"></p>
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" inputmode="email" required aria-required="true" placeholder="julie.martin@gmail.com" aria-describedby="email-error" />
            <p class="field-error" id="email-error"></p>
          </div>
          <div class="field full">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required aria-required="true" placeholder="Votre objectif, votre niveau, vos questions…" aria-describedby="message-error"></textarea>
            <p class="field-error" id="message-error"></p>
          </div>
          <div class="form-foot">
            <button type="submit" class="btn btn-solid">Envoyer <span class="arrow" aria-hidden="true">→</span></button>
            <p class="form-status" id="form-status" role="status"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script>
    import { z } from "zod/mini";

    const NOM = "Indiquez votre nom et votre prénom.";

    const schema = z.object({
      nom: z.string().check(
        z.trim(),
        z.minLength(1, { error: NOM }),
        z.refine((v) => v.split(/\s+/).length >= 2, { error: NOM }),
      ),
      email: z.pipe(
        z.string().check(z.trim()),
        z.email({ error: "Cette adresse email ne semble pas valide." }),
      ),
      message: z.string().check(
        z.trim(),
        z.minLength(10, { error: "Votre message est un peu court (10 caractères minimum)." }),
        z.maxLength(3000, { error: "Votre message est trop long (3000 caractères maximum)." }),
      ),
    });

    type Champ = keyof z.infer<typeof schema>;
    const champs: Champ[] = ["nom", "email", "message"];

    const form = document.getElementById("contactForm") as HTMLFormElement | null;

    if (form) {
      const lire = () => Object.fromEntries(champs.map((c) => [c, String(new FormData(form).get(c) ?? "")]));

      // Valide et affiche les erreurs sous chaque champ ; renvoie les données propres ou null
      const valider = () => {
        const r = schema.safeParse(lire());
        const erreurs: Partial<Record<Champ, string>> = {};
        if (!r.success) for (const i of r.error.issues) erreurs[i.path[0] as Champ] ??= i.message;

        for (const c of champs) {
          const msg = erreurs[c] ?? "";
          (form.elements.namedItem(c) as HTMLElement).setAttribute("aria-invalid", String(!!msg));
          document.getElementById(`${c}-error`)!.textContent = msg;
        }
        return r.success ? r.data : null;
      };

      let tente = false;

      // Après un premier envoi raté, on revalide à la frappe pour effacer les erreurs corrigées
      form.addEventListener("input", () => { if (tente) valider(); });

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        tente = true;
        const data = valider();
        if (!data) {
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          return;
        }

        const sujet = `Contact site · ${data.nom}`;
        const corps = `Nom et prénom : ${data.nom}\nEmail : ${data.email}\n\nMessage :\n${data.message}\n`;

        window.location.href =
          "mailto:contact@oliviergaillard.fr" +
          "?subject=" + encodeURIComponent(sujet) +
          "&body=" + encodeURIComponent(corps);
      });
    }
  </script>

</Base>
