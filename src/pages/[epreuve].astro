---
import Base from "@/layouts/Base.astro";
import ARemplir from "@/components/ARemplir.astro";
import { EPREUVES, PUBLIE, epreuve, estARemplir, type Epreuve } from "@/data/epreuves";

export function getStaticPaths() {
  return EPREUVES.map((e) => ({ params: { epreuve: e.slug }, props: { e } }));
}

const { e } = Astro.props as { e: Epreuve };
const suivante = epreuve(e.suivante);

const site = Astro.site ?? new URL("https://olivier-gaillard.fr");
const url = new URL(`/${e.slug}`, site).href;
const personId = new URL("/#olivier-gaillard", site).href;

const photo = `/assets/${e.photo}`;
const srcset = `${photo}-768.webp 768w, ${photo}-1280.webp 1280w, ${photo}-1920.webp 1920w`;
const derniere = e.lignes.length - 1;

const brouillon = !e.relu || [e.approche.texte, e.cas, e.photos, e.parcours].some(estARemplir);
if (brouillon && process.env.VERCEL_ENV === "production") {
  throw new Error(`/${e.slug} : textes d'Olivier manquants ou non relus, page non publiable en production`);
}

const majLe = new Date(PUBLIE).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });

const jsonLd: Record<string, unknown>[] = [
  {
    "@type": "Article",
    "@id": `${url}#article`,
    headline: e.h1,
    description: e.description,
    image: new URL(e.og, site).href,
    inLanguage: "fr-FR",
    datePublished: PUBLIE,
    dateModified: PUBLIE,
    author: { "@id": personId },
    publisher: { "@id": personId },
    mainEntityOfPage: url,
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: e.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.r },
    })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: new URL("/", site).href },
      { "@type": "ListItem", position: 2, name: e.h1, item: url },
    ],
  },
];
---

<Base
  title={e.title}
  description={e.description}
  active="course"
  image={e.og}
  imageAlt={e.ogAlt}
  jsonLd={jsonLd}
  preload={{ href: `${photo}-1920.webp`, srcset, sizes: "100vw" }}
>

  <!-- ================= HERO PAGE ================= -->
  <section class="page-hero page-hero--photo page-hero--course">
    <div class="page-hero-media" aria-hidden="true">
      <img
        src={`${photo}-1920.webp`}
        srcset={srcset}
        sizes="100vw"
        width="1920"
        height="818"
        fetchpriority="high"
        decoding="async"
        alt=""
      />
    </div>
    <div class="container">
      <h1 class="hero-title">
        {e.lignes.map((l, i) => (
          <><span class="line">{l}{i === derniere && <span class="accent">{e.accent}</span>}</span>{" "}</>
        ))}
      </h1>
      <p class="lead">{e.lead}</p>
      <div class="hero-actions">
        <a href="/#contact" class="btn btn-solid">Premier échange gratuit <span class="arrow" aria-hidden="true">→</span></a>
        <a href="#seances" class="btn btn-ghost">{e.seances.titre}</a>
      </div>
    </div>
  </section>

  {!e.relu && (
    <div class="container">
      <ARemplir consigne="Les durées, la semaine type, les erreurs et la FAQ de cette page sont un premier jet : relis-les, corrige les chiffres et remplace ce qui ne correspond pas à ce que tu fais vraiment." />
    </div>
  )}

  <!-- ================= TEXTE ================= -->
  {e.sections.map((s) => (
    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 class="section-title">{s.titre}</h2>
        </div>
        <div class="text-block course-text" data-reveal="1">
          {s.paragraphes.map((p) => <p set:html={p} />)}
        </div>
      </div>
    </section>
  ))}

  <!-- ================= PARCOURS COMMENTÉ ================= -->
  {e.parcours && (
    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2 class="section-title">Le parcours commenté</h2>
        </div>
        <div class="text-block course-text" data-reveal="1">
          {estARemplir(e.parcours)
            ? <ARemplir consigne={e.parcours.aRemplir} />
            : e.parcours.map((p) => <p set:html={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ================= SÉANCES ================= -->
  <section class="section" id="seances">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">{e.seances.titre}</h2>
      </div>
      <div class="steps" data-reveal="1">
        {e.seances.items.map((s, i) => (
          <div class="step">
            <div class="step-num">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="step-title">{s.titre}</h3>
            <p>{s.texte}</p>
          </div>
        ))}
      </div>
      <p class="steps-note" data-reveal="2">
        <strong>{e.seances.note.titre}</strong> : {e.seances.note.texte}
      </p>
    </div>
  </section>

  <!-- ================= APPROCHE ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">{e.approche.titre}</h2>
      </div>
      <div class="text-block course-text" data-reveal="1">
        {estARemplir(e.approche.texte)
          ? <ARemplir consigne={e.approche.texte.aRemplir} />
          : e.approche.texte.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- ================= ERREURS ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">Les erreurs que je vois le plus souvent</h2>
      </div>
      <ul class="plan-list course-errors" data-reveal="1">
        {e.erreurs.map((x) => (
          <li><strong>{x.titre}</strong> {x.texte}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= CAS CONCRET ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">Un cas concret</h2>
      </div>
      <div class="text-block course-text" data-reveal="1">
        {estARemplir(e.cas)
          ? <ARemplir consigne={e.cas.aRemplir} />
          : e.cas.map((p) => <p set:html={p} />)}
      </div>
      {estARemplir(e.photos)
        ? <ARemplir consigne={e.photos.aRemplir} />
        : (
          <div class="course-photos" data-reveal="2">
            {e.photos.map((ph) => (
              <figure>
                <img src={ph.src} alt={ph.alt} loading="lazy" decoding="async" width="800" height="600" />
                <figcaption>{ph.legende}</figcaption>
              </figure>
            ))}
          </div>
        )}
    </div>
  </section>

  <!-- ================= SUIVI ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">Ce que change un suivi</h2>
      </div>
      <div class="text-block course-text" data-reveal="1">
        <p set:html={e.suivi} />
        <p>
          Je suis <a href="/coach">entraîneur diplômé de la Fédération Française
          d'Athlétisme</a> et j'accompagne des coureurs depuis 2009, partout en
          France.
        </p>
        <a href="/coaching-a-distance" class="more-link">Le suivi en ligne en détail <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">Questions fréquentes</h2>
      </div>
      <div class="faq" data-reveal="1">
        {e.faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <div class="faq-answer">
              <p>{f.r}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= AUTEUR ================= -->
  <section class="section course-auteur-wrap">
    <div class="container">
      <aside class="course-auteur" data-reveal>
        <img
          src="/assets/olivier-qui-suis-je-480.webp"
          width="480"
          height="640"
          loading="lazy"
          decoding="async"
          alt="Olivier Gaillard, entraîneur d'athlétisme FFA"
        />
        <div>
          <p class="course-auteur-nom">Écrit par <a href="/coach">Olivier Gaillard</a></p>
          <p>
            Entraîneur diplômé de la Fédération Française d'Athlétisme, licence
            STAPS et DU de préparation physique. J'entraîne depuis 2009 et j'ai
            fondé le groupe <a href="/athlete-project">Athlete Project</a> à
            l'Athletic Club du Lyonnais.
          </p>
          <p class="course-auteur-date">Mis à jour le <time datetime={PUBLIE}>{majLe}</time></p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section class="section cta-band">
    <div class="container">
      <h2 class="section-title" data-reveal>On en parle ?</h2>
      <p class="lead" data-reveal="1">
        Racontez-moi votre objectif. Le premier échange est gratuit, sans
        engagement, et je réponds à tout le monde.
      </p>
      <div class="hero-actions" data-reveal="2">
        <a href="/#contact" class="btn btn-solid">Me contacter <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/#tarifs" class="btn btn-ghost">Voir les formules</a>
      </div>
    </div>
  </section>

  <!-- ================= LIEN SUIVANT ================= -->
  <a href={`/${suivante.slug}`} class="next-link">
    <div class="container">
      <div class="nl-label">Préparer aussi</div>
      <span class="nl-title">{suivante.court} <span aria-hidden="true">→</span></span>
    </div>
  </a>

</Base>
