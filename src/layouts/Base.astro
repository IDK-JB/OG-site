---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Consent from "@/components/Consent.astro";
import { CONTACT_EMAIL, INDEXABLE, OFFRES } from "@/seo";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// Empreinte du fichier pour invalider le cache navigateur à chaque build
const version = (file: string) =>
  createHash("md5").update(readFileSync(resolve(process.cwd(), file))).digest("hex").slice(0, 10);
const cssVersion = version("public/css/style.css");
const jsVersion = version("public/js/main.js");

const DEFAULT_IMAGE = "/assets/og-default.jpg";

interface Preload {
  href: string;
  srcset?: string;
  sizes?: string;
}

interface Props {
  title: string;
  description: string;
  active: "home" | "coach" | "distance" | "ap" | "legal" | "course";
  home?: boolean;
  bodyClass?: string;
  /** Image de partage (Open Graph), chemin depuis /public */
  image?: string;
  imageAlt?: string;
  /** Image principale (LCP) à précharger */
  preload?: Preload;
  /** Données structurées propres à la page */
  jsonLd?: Record<string, unknown>[];
  /** Page hors index (404) : noindex, sans canonical ni og:url */
  noindex?: boolean;
}

const {
  title,
  description,
  active,
  home = false,
  bodyClass,
  image = DEFAULT_IMAGE,
  imageAlt = "Olivier Gaillard, coach running à Lyon",
  preload,
  jsonLd = [],
  noindex = false,
} = Astro.props;

// Les images de partage générées (og-*.jpg) font toutes 1200x630.
const isOgCard = /\/og-[\w-]+\.jpg$/.test(image);
const robots = noindex
  ? "noindex"
  : INDEXABLE
    ? "index, follow, max-image-preview:large"
    : "noindex, nofollow";

const site = Astro.site ?? new URL("https://olivier-gaillard.fr");
const path =
  Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/\/$/, "") || "/";
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;

// Entité commune à toutes les pages : identifie CET Olivier Gaillard
// (coach running à Lyon) et le distingue de ses homonymes.
const personId = new URL("/#olivier-gaillard", site).href;
const businessId = new URL("/#coaching", site).href;
const websiteId = new URL("/#site", site).href;

const graph = [
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: new URL("/", site).href,
    name: "Olivier Gaillard",
    alternateName: ["Olivier Gaillard, coach running à Lyon", "olivier-gaillard.fr"],
    inLanguage: "fr-FR",
    publisher: { "@id": personId },
  },
  {
    "@type": "Person",
    "@id": personId,
    name: "Olivier Gaillard",
    jobTitle: "Entraîneur d'athlétisme et coach running",
    description:
      "Entraîneur diplômé de la Fédération Française d'Athlétisme, spécialiste demi-fond et running, basé à Lyon. Fondateur du groupe Athlete Project à l'Athletic Club du Lyonnais.",
    url: new URL("/coach", site).href,
    image: new URL("/assets/olivier-qui-suis-je.webp", site).href,
    email: CONTACT_EMAIL,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Lyon",
      addressRegion: "Auvergne-Rhône-Alpes",
      addressCountry: "FR",
    },
    worksFor: { "@id": businessId },
    affiliation: {
      "@type": "SportsClub",
      name: "Athletic Club du Lyonnais (ACL)",
      address: { "@type": "PostalAddress", addressLocality: "Lyon", addressCountry: "FR" },
    },
    hasCredential: [
      { "@type": "EducationalOccupationalCredential", name: "Entraîneur fédéral demi-fond et running (FFA)" },
      { "@type": "EducationalOccupationalCredential", name: "Licence STAPS" },
      { "@type": "EducationalOccupationalCredential", name: "DU de préparation physique" },
      { "@type": "EducationalOccupationalCredential", name: "Certification entraînement de haut niveau et prophylaxie (INSEP)" },
    ],
    knowsAbout: [
      "Course à pied",
      "Running",
      "Athlétisme",
      "Demi-fond",
      "Préparation marathon",
      "Préparation semi-marathon",
      "Préparation 10 km",
      "Cross-country",
      "Préparation physique",
    ],
    sameAs: [
      "https://www.instagram.com/olivier_gllrd",
      "https://www.strava.com/athletes/6312500",
      "https://www.nolio.io/marketplace/coach/olivier.gaillard/",
    ],
  },
  {
    "@type": "ProfessionalService",
    "@id": businessId,
    name: "Olivier Gaillard, coach running et athlétisme",
    description:
      "Coaching running et athlétisme à Lyon et à distance : plans d'entraînement personnalisés sur Nolio, du premier 10 km au marathon.",
    url: new URL("/", site).href,
    image: new URL(DEFAULT_IMAGE, site).href,
    email: CONTACT_EMAIL,
    founder: { "@id": personId },
    address: {
      "@type": "PostalAddress",
      addressLocality: "Lyon",
      addressRegion: "Auvergne-Rhône-Alpes",
      addressCountry: "FR",
    },
    areaServed: [
      { "@type": "City", name: "Lyon" },
      { "@type": "AdministrativeArea", name: "Métropole de Lyon" },
      { "@type": "Country", name: "France" },
    ],
    priceRange: "80 € à 130 € par mois",
    makesOffer: OFFRES,
  },
  ...jsonLd,
];

const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta name="robots" content={robots} />
  <meta name="author" content="Olivier Gaillard" />
  <meta name="theme-color" content="#0f0f0f" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Partage réseaux sociaux -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Olivier Gaillard" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!noindex && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  {isOgCard && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:type" content="image/jpeg" />
    </>
  )}
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Performance : image principale d'abord, polices ensuite -->
  {preload && (
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href={preload.href}
      imagesrcset={preload.srcset}
      imagesizes={preload.sizes}
      fetchpriority="high"
    />
  )}
  <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Polices auto-hébergées (OFL), sous-ensemble latin. Inter est variable : un fichier pour 400 à 600 -->
  <style is:inline>
    @font-face {
      font-family: "Anton";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("/fonts/anton-latin.woff2") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: "Inter";
      font-style: normal;
      font-weight: 400 600;
      font-display: swap;
      src: url("/fonts/inter-latin-var.woff2") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
  </style>
  <link rel="stylesheet" href={`/css/style.css?v=${cssVersion}`} />

  <script type="application/ld+json" set:html={structuredData} />
</head>
<body class={bodyClass}>

  <Header active={active} home={home} />

  <main id="contenu" tabindex="-1">
    <slot />
  </main>

  <Footer home={home} />

  <script src={`/js/main.js?v=${jsVersion}`} is:inline></script>

  <!-- Mesure d'audience Vercel, chargée seulement après accord -->
  <Consent />
</body>
</html>
