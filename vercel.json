{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [{ "source": "/ap", "destination": "/athlete-project", "permanent": true }],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "olivier-gaillard.fr" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
